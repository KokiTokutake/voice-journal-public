<UserControl x:Class="VoiceJournal.App.Views.TranscriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:VoiceJournal.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoiceJournal.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:TranscriptViewModel}"
             x:Name="Root">
    <!-- AT-25 / 18.1: below the minimum size (e.g. 200 % scaling on a small screen) the page scrolls instead of squeezing -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border Padding="24,8,24,24" MinHeight="{DynamicResource VjSize540}" Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid>
        <!-- Nothing opened yet -->
        <TextBlock Margin="12,16" TextWrapping="Wrap"
                   Text="ライブラリでセッションを選び、「文字起こしを開く」を押すと、ここに表示します。">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSession}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <!-- Session, revision, filters -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{Binding SessionTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <WrapPanel>
                    <Label Content="Revision(_V)" Target="{Binding ElementName=RevisionBox}" VerticalAlignment="Center" Padding="0,0,8,0" />
                    <ComboBox x:Name="RevisionBox" MinWidth="280" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}"
                              DisplayMemberPath="Label" AutomationProperties.Name="表示する Revision" Margin="0,0,8,0" />
                    <Button Content="この Revision を使う(_U)" Tag="&#xE73E;" Command="{Binding AdoptCommand}" Style="{StaticResource ActionButton}" Margin="0,0,20,0"
                            ToolTip="表示している Revision を使用中にします。修正と区間の再認識は使用中の Revision から続けます（ほかの Revision は消えません）" />
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="両方" GroupName="Src" Style="{StaticResource Segment}" Tag="&#xE8F2;"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=All}" />
                            <RadioButton Content="マイク" GroupName="Src" Style="{StaticResource Segment}" Tag="&#xE720;"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Mic}" />
                            <RadioButton Content="PC 内部音声" GroupName="Src" Style="{StaticResource Segment}" Tag="&#xE767;"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Loopback}" />
                        </StackPanel>
                    </Border>
                    <CheckBox Content="要確認だけ表示(_Q)" IsChecked="{Binding FlaggedOnly}" VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="品質の目印（無音・反復・境界など）か、数字・期日・否定・人名を含む区間だけを表示します" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Note}" VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock Text="{Binding ProvenanceText}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding UnrecognizedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding UnrecognizedText, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>

            <!-- Actions -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="区間を再生(_P)" Tag="&#xE768;" Command="{Binding PlaySelectedCommand}" Style="{StaticResource ActionButton}" />
                        <Button Content="停止(_X)" Tag="&#xE71A;" Command="{Binding StopPlaybackCommand}" Style="{StaticResource ActionButton}" />
                        <Button Content="原文に戻す(_H)" Tag="&#xE7A7;" Command="{Binding RevertCommand}" Style="{StaticResource ActionButton}"
                                ToolTip="選んだ区間を、元の原文に戻した新しい Revision を作ります" />
                        <Label Content="再認識のモデル(_D)" Target="{Binding ElementName=ModelBox}" VerticalAlignment="Center" Padding="16,0,8,0" />
                        <ComboBox x:Name="ModelBox" MinWidth="220" ItemsSource="{Binding ModelOptions}" SelectedValuePath="Name" DisplayMemberPath="Label"
                                  SelectedValue="{Binding ReRecognizeModel}" AutomationProperties.Name="再認識に使うモデル" VerticalAlignment="Center" />
                        <Button Content="選んだ区間を再認識(_N)" Tag="&#xE72C;" Command="{Binding ReRecognizeCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=SegmentGrid}" Style="{StaticResource AccentActionButton}" Margin="8,0,0,0"
                                ToolTip="選んだ区間（同じ音源、複数可）の時間を、もう一度文字起こしして新しい Revision にします" />
                    </WrapPanel>
                    <TextBlock Text="{Binding NowPlaying}" Style="{StaticResource Note}" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding NowPlaying, Converter={StaticResource TextToVisibility}}" AutomationProperties.LiveSetting="Polite" services:LiveText.Announce="True" />
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="4,8,0,0" AutomationProperties.LiveSetting="Polite" services:LiveText.Announce="True" />

            <!-- Segments: the text column is editable on the revision in use -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid services:TextScaling.ScaleColumns="True" x:Name="SegmentGrid" ItemsSource="{Binding Segments}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                          IsReadOnly="{Binding IsCurrent, Converter={StaticResource Inverse}}" SelectionMode="Extended" SelectionUnit="FullRow"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          AutomationProperties.Name="文字起こしの区間">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE768;" FontFamily="{StaticResource IconFont}" Padding="6,2" Margin="2"
                                            Command="{Binding DataContext.PlayCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            ToolTip="この区間を再生" AutomationProperties.Name="この区間を再生" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="時刻" Binding="{Binding TimeText}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="音源" Binding="{Binding SourceText}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="本文（ダブルクリックで修正）" Binding="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="4,6" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="品質の目印" Binding="{Binding FlagsText}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource CautionBorderBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="4,6" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="要確認" Binding="{Binding HintText}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="4,6" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="修正" Binding="{Binding EditedText}" Width="50" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
    </Border>
    </ScrollViewer>
</UserControl>
