<UserControl x:Class="VoiceJournal.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoiceJournal.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <StackPanel Margin="24,8,24,24" MaxWidth="900" HorizontalAlignment="Left">
        <!-- Transcription (UI-12) -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="文字起こし" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="モデル(_M)" Target="{Binding ElementName=ModelBox}" VerticalAlignment="Center" Padding="0" />
                    <ComboBox x:Name="ModelBox" Grid.Row="0" Grid.Column="1" Margin="0,4" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260"
                              ItemsSource="{Binding ModelOptions}" SelectedValuePath="Name" DisplayMemberPath="Label" SelectedValue="{Binding ModelName}"
                              AutomationProperties.Name="文字起こしのモデル" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsChecked="{Binding UseVad}"
                              Content="無音の部分を飛ばして認識する（VAD、推奨。無音から文が作られる誤りを防ぎます）(_V)" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" IsChecked="{Binding NormalizeGain}"
                              Content="小さい音声の音量をそろえてから認識する（原音は変えません）(_N)" />
                    <Label Grid.Row="3" Content="CPU のスレッド数(_H)" Target="{Binding ElementName=ThreadBox}" VerticalAlignment="Center" Padding="0" Margin="0,8,0,0" />
                    <ComboBox x:Name="ThreadBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,4" Width="90" HorizontalAlignment="Left"
                              ItemsSource="{Binding ThreadOptions}" SelectedItem="{Binding Threads}" AutomationProperties.Name="CPU のスレッド数" />
                </Grid>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Note}" TextWrapping="Wrap"
                           Text="変更はすぐに保存され、次に始める文字起こしから使われます。録音中は文字起こしを一時停止し、録音が終わると再開します。" />
                <TextBlock Margin="0,6,0,0" Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <!-- Record generation (UI-12, detail spec 9.1 / 9.2) -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasLlm, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="記録の作成" Style="{StaticResource SectionTitle}" />
                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Text="アプリの推論エンジン（llama.cpp）で、使用中の文字起こしから記録を作ります。" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="モデル ID(_D)" Target="{Binding ElementName=LlmModelBox}" VerticalAlignment="Center" Padding="0" />
                    <TextBox x:Name="LlmModelBox" Grid.Row="0" Grid.Column="1" Margin="0,4" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260"
                             Text="{Binding LlmModelId, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="モデル ID" />
                    <Label Grid.Row="1" Content="コンテキスト長 C(_C)" Target="{Binding ElementName=LlmContextBox}" VerticalAlignment="Center" Padding="0" />
                    <TextBox x:Name="LlmContextBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Width="100" HorizontalAlignment="Left"
                             Text="{Binding LlmContextLength, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="コンテキスト長"
                             ToolTip="推論エンジンを起動するときのコンテキスト長" />
                    <Label Grid.Row="2" Content="出力の予約 O(_O)" Target="{Binding ElementName=LlmReserveBox}" VerticalAlignment="Center" Padding="0" />
                    <TextBox x:Name="LlmReserveBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Width="100" HorizontalAlignment="Left"
                             Text="{Binding LlmOutputReserve, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="出力の予約"
                             ToolTip="1 回の応答に使えるトークン数。コンテキスト長の半分以下" />
                    <Label Grid.Row="3" Content="区間の大きさ(_P)" Target="{Binding ElementName=LlmPieceBox}" VerticalAlignment="Center" Padding="0" />
                    <TextBox x:Name="LlmPieceBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Width="100" HorizontalAlignment="Left"
                             Text="{Binding LlmPieceTokens, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="区間の大きさ（トークン）"
                             ToolTip="長い文字起こしを分ける大きさ（トークン）。大きいほど速く、小さいほど細部が残ります" />
                </Grid>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Note}" TextWrapping="Wrap"
                           Text="推論エンジンは、記録を作るときだけ起動し、使わなければ 1 分ほどで終了します。空きメモリが足りないときは起動しません。録音中と文字起こし中は、記録の作成を待たせます。" />
                <TextBlock Margin="0,6,0,0" Text="{Binding LlmMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding LlmMessage, Converter={StaticResource TextToVisibility}}" />
                <Button Content="接続を確認(_T)" Tag="&#xE703;" Command="{Binding CheckLlmCommand}" Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Left" Margin="0,10,0,6" />
                <TextBlock Text="{Binding LlmStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding LlmStatus, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Tools -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="文字起こしのツール" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap">
                    <Run Text="登録した whisper-cli とモデルだけを、SHA-256 を照合してから使います。" /><LineBreak />
                    <Run Text="whisper-cli: " /><Run Text="{Binding WhisperPath, Mode=OneWay}" />
                </TextBlock>
                <Button Content="ツールを確認(_K)" Tag="&#xE73E;" Command="{Binding VerifyToolsCommand}" Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Left" Margin="0,10,0,6" />
                <ItemsControl ItemsSource="{Binding ToolStatus}" AutomationProperties.Name="ツールの確認結果">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Storage -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="保存先" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding WorkspaceRoot}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="保存先の変更、管理ファイル、バックアップなどの設定は後のフェーズで追加します。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
