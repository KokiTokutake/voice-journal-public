<UserControl x:Class="VoiceJournal.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoiceJournal.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}">
    <!-- AT-25 / 18.1: below the minimum size (e.g. 200 % scaling on a small screen) the page scrolls instead of squeezing -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border Padding="24,8,24,24" MinHeight="460" Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <DockPanel>
        <!-- Search and refresh -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Note}" />
            <Button DockPanel.Dock="Right" Content="一覧を更新(_U)" Tag="&#xE72C;" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}" Margin="12,0,0,0" />
            <Grid MaxWidth="440" HorizontalAlignment="Left" MinWidth="280">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,8,6"
                         AutomationProperties.Name="タイトル・project・日付・文字起こしの本文で検索" ToolTip="タイトル・project・日付、または文字起こしの本文の一部で検索します" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Label Content="検索(_K)" Target="{Binding ElementName=SearchBox}" Width="0" Padding="0" />
        </DockPanel>

        <!-- Player / actions -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Left">
                    <Button Content="マイクを再生(_M)" Tag="&#xE768;" Command="{Binding PlayMicCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="PC 内部音声を再生(_I)" Tag="&#xE768;" Command="{Binding PlayLoopbackCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="停止(_X)" Tag="&#xE71A;" Command="{Binding StopPlaybackCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="フォルダーを開く(_F)" Tag="&#xE838;" Command="{Binding OpenFolderCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="文字起こし(_A)" Tag="&#xE8D2;" Command="{Binding TranscribeCommand}" Style="{StaticResource ActionButton}"
                            ToolTip="今の設定で文字起こしします。文字起こし済みなら、以前の結果を残したまま新しい原文を作ります" />
                    <Button Content="文字起こしを開く(_E)" Tag="&#xE8A5;" Command="{Binding OpenTranscriptCommand}" Style="{StaticResource AccentActionButton}" />
                    <Button Content="記録を開く(_O)" Tag="&#xE7C3;" Command="{Binding OpenRecordCommand}" Style="{StaticResource AccentActionButton}"
                            ToolTip="要約・章・課題とタスクの候補を確かめて承認する画面を開きます（記録がなければそこで作れます）" />
                    <Button Content="書き出す(_W)" Tag="&#xEDE1;" Command="{Binding ExportCommand}" Style="{StaticResource ActionButton}"
                            ToolTip="記録と文字起こしを Markdown で、選んだフォルダーに書き出します" />
                    <Button Content="削除(_D)" Tag="&#xE74D;" Command="{Binding DeleteCommand}" Style="{StaticResource ActionButton}"
                            ToolTip="確かめてから、セッションをワークスペースの trash フォルダーへ移します（すぐには消しません）" />
                </WrapPanel>
                <TextBlock Text="{Binding NowPlaying}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource Note}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="4,8,0,0" AutomationProperties.LiveSetting="Polite" />

        <!-- List -->
        <Border Style="{StaticResource Card}" Padding="0" Margin="0">
            <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None"
                      BorderThickness="0" Background="Transparent" RowHeight="40" AutomationProperties.Name="録音の一覧"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="開始日時" Binding="{Binding StartedText}" SortMemberPath="StartedLocal" Width="150" />
                    <DataGridTextColumn Header="タイトル" Binding="{Binding TitleText}" Width="*" />
                    <DataGridTextColumn Header="project" Binding="{Binding ProjectText}" Width="140" />
                    <DataGridTextColumn Header="長さ" Binding="{Binding DurationText}" SortMemberPath="Duration" Width="80" />
                    <DataGridTextColumn Header="音源" Binding="{Binding ModeText}" Width="110" />
                    <DataGridTextColumn Header="状態" Binding="{Binding StateText}" Width="140" />
                    <DataGridTextColumn Header="欠損" Binding="{Binding LossText}" Width="110" />
                    <DataGridTextColumn Header="文字起こし" Binding="{Binding ProcessingText}" Width="130" />
                    <DataGridTextColumn Header="記録" Binding="{Binding RecordText}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
    </Border>
    </ScrollViewer>
</UserControl>
