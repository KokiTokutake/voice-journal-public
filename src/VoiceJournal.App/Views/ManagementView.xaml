<UserControl x:Class="VoiceJournal.App.Views.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoiceJournal.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ManagementViewModel}">
    <UserControl.Resources>
        <!-- UI-08: one candidate card -->
        <DataTemplate x:Key="CandidateCard" DataType="{x:Type vm:CandidateCardViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ActionText}" Style="{StaticResource Note}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Note}" FontWeight="SemiBold" />
                    </WrapPanel>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,2" Padding="4,3" FontSize="15"
                             AutomationProperties.Name="候補のタイトル" ToolTip="タイトルを直せます（確定はフォーカスを外したとき）" />
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,2" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource Note}"
                               Visibility="{Binding Description, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding ConcernText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2"
                               Visibility="{Binding ConcernText, Converter={StaticResource TextToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Evidence}" Focusable="False" Margin="0,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=根拠 {0}}" TextWrapping="Wrap" Style="{StaticResource Note}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DuplicateText}" TextWrapping="Wrap" Margin="0,2"
                               Visibility="{Binding DuplicateText, Converter={StaticResource TextToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Choices}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChoiceOption}">
                                <RadioButton Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}"
                                             Margin="0,0,14,0" AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding NeedsTarget, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="対象の既存項目" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label" MinWidth="320"
                                  AutomationProperties.Name="対象の既存項目" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding ShowParent, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="親課題" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ParentIssues}" SelectedItem="{Binding SelectedParent}" DisplayMemberPath="Label" MinWidth="320"
                                  AutomationProperties.Name="親課題" />
                    </StackPanel>
                    <CheckBox Content="{Binding ConfirmationLabel}" IsChecked="{Binding ConfirmedIndividually}" Margin="0,8,0,0"
                              Visibility="{Binding NeedsConfirmation, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="個別に確認しました" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,8,24,16">
        <!-- Session and refresh -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="課題・タスクの候補のレビュー" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <WrapPanel>
                <Label Content="セッション(_N)" Target="{Binding ElementName=SessionBox}" VerticalAlignment="Center" Padding="0,0,8,0" />
                <ComboBox x:Name="SessionBox" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Label"
                          MinWidth="420" Margin="0,0,10,0" />
                <Button Content="再読み込み" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}" Margin="0,0,16,0" />
                <CheckBox Content="課題のファイルは追記だけ" IsChecked="{Binding IssuesAppendOnly}" VerticalAlignment="Center" Margin="0,0,12,0"
                          ToolTip="既存の課題は書き換えず、更新は提案として保存します（11.4 追記専用）" />
                <CheckBox Content="タスクのファイルは追記だけ" IsChecked="{Binding TasksAppendOnly}" VerticalAlignment="Center"
                          ToolTip="既存のタスクは書き換えず、更新は提案として保存します（11.4 追記専用）" />
            </WrapPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource Note}" Margin="0,6,0,0"
                       Visibility="{Binding Message, Converter={StaticResource TextToVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- UI-10: management list, UI-11: plans waiting and history -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding ItemsTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180" HeadersVisibility="Column"
                      AutomationProperties.Name="管理一覧">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding DisplayId}" />
                    <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="状態" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="担当" Binding="{Binding Assignee}" />
                    <DataGridTextColumn Header="期限" Binding="{Binding Due}" />
                    <DataGridTextColumn Header="プロジェクト" Binding="{Binding Project}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="変更計画（反映待ち・履歴）" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding Batches}" MaxHeight="180" AutomationProperties.Name="変更計画の履歴" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BatchRow}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding CanApply, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="反映" Padding="8,1" Margin="4,0" Command="{Binding DataContext.ApplyBatchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="この計画を反映" />
                                <Button Content="破棄" Padding="8,1" Command="{Binding DataContext.AbandonBatchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="この計画を破棄" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="取り消す" Padding="8,1" Margin="4,0"
                                    Visibility="{Binding CanRevert, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.RevertBatchCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="この反映を取り消す" />
                            <TextBlock TextWrapping="Wrap" ToolTip="{Binding Folder}">
                                <Run Text="{Binding Created, Mode=OneWay}" /><Run Text="　" /><Run Text="{Binding StateText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="　" /><Run Text="{Binding Counts, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- UI-08: candidate cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CandidateCard}" Focusable="False"
                              AutomationProperties.Name="課題・タスクの候補" />
            </ScrollViewer>

            <!-- UI-09: final check -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding ReadyText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Content="通常の新規候補をすべて選択(_A)" Command="{Binding SelectPlainCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                        <Button Content="変更計画を作る(_P)" Command="{Binding BuildPlanCommand}" Style="{StaticResource AccentActionButton}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" Margin="0,4"
                               Visibility="{Binding PlanSummary, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding PlanNotes}" TextWrapping="Wrap" Style="{StaticResource Note}" Margin="0,4"
                               Visibility="{Binding PlanNotes, Converter={StaticResource TextToVisibility}}" />
                    <WrapPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="選択した変更を反映(_R)" Command="{Binding SaveAndApplyCommand}" Style="{StaticResource AccentActionButton}" Margin="0,0,8,6"
                                IsEnabled="{Binding CanApply}" ToolTip="計画を保存し、元の内容をバックアップしてから管理ファイルを書き換えます" />
                        <Button Content="計画だけ保存(_K)" Command="{Binding SavePlanCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,6" />
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PlannedFiles}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PlannedFileRow}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Diff, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas, MS Gothic" FontSize="12"
                                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Header}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
