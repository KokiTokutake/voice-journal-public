<UserControl x:Class="VoiceJournal.App.Views.RecordReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoiceJournal.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:RecordReviewViewModel}"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Evidence chips: jump to the segment on the left and play it -->
        <DataTemplate x:Key="EvidenceChips">
            <ItemsControl ItemsSource="{Binding}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EvidenceLink}">
                        <Button Content="{Binding Label}" ToolTip="{Binding ToolTip}" Padding="6,1" Margin="0,2,6,2" FontSize="{DynamicResource VjFont12}"
                                Command="{Binding DataContext.ShowEvidenceCommand, ElementName=Root}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding ToolTip}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <Style x:Key="EditableText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- AT-25 / 18.1: below the minimum size (e.g. 200 % scaling on a small screen) the page scrolls instead of squeezing -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border Padding="24,8,24,24" MinHeight="{DynamicResource VjSize520}" Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <Grid>
        <!-- Nothing opened yet -->
        <TextBlock Margin="12,16" TextWrapping="Wrap"
                   Text="ライブラリでセッションを選び、「記録を開く」を押すと、ここに表示します。">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSession}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <!-- Session, revision, review state -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="{Binding SessionTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <WrapPanel Visibility="{Binding HasRecord, Converter={StaticResource BoolToVisibility}}">
                    <Label Content="Revision(_V)" Target="{Binding ElementName=RevisionBox}" VerticalAlignment="Center" Padding="0,0,8,0" />
                    <ComboBox x:Name="RevisionBox" MinWidth="300" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}"
                              DisplayMemberPath="Label" AutomationProperties.Name="表示する記録の Revision" Margin="0,0,8,0" />
                </WrapPanel>
                <Border BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,8,0,0"
                        Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource CautionBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Border>
                <Border BorderThickness="1" BorderBrush="{StaticResource CautionBorderBrush}" CornerRadius="8" Padding="14,8" Margin="0,8,0,0"
                        Visibility="{Binding WarningsText, Converter={StaticResource TextToVisibility}}">
                    <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Actions -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="承認(_A)" Tag="&#xE73E;" Command="{Binding ApproveCommand}" Style="{StaticResource AccentActionButton}"
                                ToolTip="最新の Revision を承認し、record.md に保存します。課題・タスクの候補は承認されません（未反映のまま）" />
                        <Button Content="保留／解除(_H)" Tag="&#xE769;" Command="{Binding DeferCommand}" Style="{StaticResource ActionButton}"
                                ToolTip="あとで確かめる記録に印を付けます。もう一度押すと解除します" />
                        <Button Content="{Binding GenerateLabel}" Tag="&#xE72C;" Command="{Binding GenerateCommand}" Style="{StaticResource ActionButton}" Margin="16,0,0,0"
                                ToolTip="使用中の文字起こしから、推論エンジンで記録を作ります。今の記録は前の Revision として残ります" />
                        <Button Content="区間を再生(_P)" Tag="&#xE768;" Command="{Binding PlaySelectedCommand}" Style="{StaticResource ActionButton}" Margin="16,0,0,0" />
                        <Button Content="停止(_X)" Tag="&#xE71A;" Command="{Binding StopPlaybackCommand}" Style="{StaticResource ActionButton}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding JobText}" Margin="2,6,0,0" FontWeight="SemiBold"
                               Visibility="{Binding JobText, Converter={StaticResource TextToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding NowPlaying}" Style="{StaticResource Note}" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding NowPlaying, Converter={StaticResource TextToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="4,8,0,0" AutomationProperties.LiveSetting="Polite" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="240" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="3*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Left: the transcript the record was built on -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TranscriptCaption}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="12,10,12,6" />
                        <ListBox x:Name="SegmentList" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="記録の元の文字起こし" SelectionChanged="OnSegmentSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SegmentRowViewModel}">
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Left" Content="&#xE768;" FontFamily="{StaticResource IconFont}" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Top"
                                                Command="{Binding DataContext.PlayCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                ToolTip="この区間を再生" AutomationProperties.Name="この区間を再生" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Note}">
                                                <Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SourceText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" />

                <!-- Right: the record -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <TextBlock Margin="16" TextWrapping="Wrap" Style="{StaticResource Note}" Visibility="{Binding HasNoRecord, Converter={StaticResource BoolToVisibility}}"
                                   Text="まだ記録がありません。下の「記録を作る」で、使用中の文字起こしから推論エンジンが要約と課題・タスクの候補を作ります。" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasRecord, Converter={StaticResource BoolToVisibility}}"
                                      Padding="16,12">
                            <StackPanel>
                                <Label Content="題名(_I)" Target="{Binding ElementName=TitleBox}" Padding="0,0,0,4" />
                                <TextBox x:Name="TitleBox" Text="{Binding RecordTitle, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsTitleReadOnly}"
                                         Style="{StaticResource EditableText}" FontSize="{DynamicResource VjFont20}" FontWeight="SemiBold" AutomationProperties.Name="記録の題名" />

                                <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SectionRowViewModel}">
                                            <StackPanel Margin="0,12,0,0">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding IsSectionEditable, Converter={StaticResource BoolToVisibility}}">
                                                        <Button Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Padding="6,3" Margin="2,0"
                                                                Command="{Binding DataContext.RegenerateSectionCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                ToolTip="この章だけを、根拠の区間から推論エンジンで作り直します（今の内容は前の Revision に残ります）" AutomationProperties.Name="この章を作り直す" />
                                                        <Button Content="&#xE70E;" FontFamily="{StaticResource IconFont}" Padding="6,3" Margin="2,0"
                                                                Command="{Binding DataContext.MoveSectionUpCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                ToolTip="章を上へ" AutomationProperties.Name="章を上へ" />
                                                        <Button Content="&#xE70D;" FontFamily="{StaticResource IconFont}" Padding="6,3" Margin="2,0"
                                                                Command="{Binding DataContext.MoveSectionDownCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                ToolTip="章を下へ" AutomationProperties.Name="章を下へ" />
                                                        <Button Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Padding="6,3" Margin="2,0"
                                                                Command="{Binding DataContext.DeleteSectionCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                ToolTip="この章を削除（前の Revision には残ります）" AutomationProperties.Name="この章を削除" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding Heading, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsHeadingReadOnly}"
                                                             Style="{StaticResource EditableText}" FontSize="{DynamicResource VjFont16}" FontWeight="SemiBold" AutomationProperties.Name="章の見出し" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding CompareText}" Foreground="{StaticResource CautionBorderBrush}" TextWrapping="Wrap" Margin="6,0,0,0"
                                                           Visibility="{Binding CompareText, Converter={StaticResource TextToVisibility}}" />

                                                <ItemsControl ItemsSource="{Binding Statements}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:StatementRowViewModel}">
                                                            <Border BorderThickness="3,0,0,0" Padding="8,2,0,2" Margin="0,4,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTentative}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource CautionBorderBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" Padding="6,3" Margin="4,0,0,0" VerticalAlignment="Top"
                                                                                Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}"
                                                                                Command="{Binding DataContext.DeleteStatementCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                                ToolTip="この文を削除" AutomationProperties.Name="この文を削除" />
                                                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                                                                                 Style="{StaticResource EditableText}" AutomationProperties.Name="記録の文" />
                                                                    </DockPanel>
                                                                    <WrapPanel Margin="6,0,0,0">
                                                                        <TextBlock Text="{Binding OriginText}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                        <ContentPresenter Content="{Binding Evidence}" ContentTemplate="{StaticResource EvidenceChips}" />
                                                                        <TextBlock Text="{Binding EvidenceNote}" Style="{StaticResource Note}" VerticalAlignment="Center"
                                                                                   Visibility="{Binding EvidenceNote, Converter={StaticResource TextToVisibility}}" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding CompareText}" Foreground="{StaticResource CautionBorderBrush}" TextWrapping="Wrap" Margin="6,0,0,0"
                                                                               Visibility="{Binding CompareText, Converter={StaticResource TextToVisibility}}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Add a statement at the end -->
                                                <DockPanel Margin="11,6,0,0" Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock DockPanel.Dock="Left" Text="＋ 追加する文:" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button DockPanel.Dock="Right" Content="追加" Margin="6,0,0,0" Padding="10,3"
                                                            Command="{Binding DataContext.AddStatementCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                            AutomationProperties.Name="文を追加" />
                                                    <TextBox Text="{Binding NewStatementText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Opacity="0.85"
                                                             AutomationProperties.Name="追加する文" ToolTip="この章の最後に追加する文（手入力の文には根拠が付きません）" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add a section -->
                                <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                                        Visibility="{Binding IsLatest, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="章を追加" FontWeight="SemiBold" />
                                        <Label Content="見出し(_M)" Target="{Binding ElementName=NewHeadingBox}" Padding="0,6,0,2" />
                                        <TextBox x:Name="NewHeadingBox" Text="{Binding NewSectionHeading, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Content="最初の文(_F)" Target="{Binding ElementName=NewSectionTextBox}" Padding="0,6,0,2" />
                                        <TextBox x:Name="NewSectionTextBox" Text="{Binding NewSectionText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                        <Button Content="章を追加(_N)" Tag="&#xE710;" Command="{Binding AddSectionCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Candidates (read-only in Phase D) -->
                                <TextBlock Text="{Binding CandidatesHeader}" Style="{StaticResource SectionTitle}" Margin="0,20,0,4" />
                                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap"
                                           Text="候補は提案です。記録を承認しても、課題・タスクの管理ファイルには書き込みません。候補は「管理」タブで確かめて承認し、反映します。" />
                                <Button Content="課題・タスクのレビューへ(_T)" Command="{Binding OpenManagementCommand}" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CandidateRowViewModel}">
                                            <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding KindText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="　" /><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="　［" /><Run Text="{Binding State, Mode=OneWay}" /><Run Text="］" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding ConcernText}" Foreground="{StaticResource CautionBorderBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding ConcernText, Converter={StaticResource TextToVisibility}}" />
                                                    <ContentPresenter Content="{Binding Evidence}" ContentTemplate="{StaticResource EvidenceChips}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding ProvenanceText}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,20,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
    </Border>
    </ScrollViewer>
</UserControl>
