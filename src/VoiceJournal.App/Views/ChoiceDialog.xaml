<Window x:Class="VoiceJournal.App.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,20" />
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
