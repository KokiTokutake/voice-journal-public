<UserControl x:Class="VoiceJournal.App.Views.ProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:VoiceJournal.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoiceJournal.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ProcessingViewModel}">
    <!-- AT-25 / 18.1: below the minimum size (e.g. 200 % scaling on a small screen) the page scrolls instead of squeezing -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border Padding="24,8,24,24" MinHeight="{DynamicResource VjSize440}" Height="{Binding ViewportHeight, ElementName=PageScroll}">
    <DockPanel>
        <!-- The running job: stage, piece and measured progress only (no guessed remaining time, detail spec 3.2) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="実行中の処理" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="進み具合" />
                <TextBlock Text="{Binding PausedText}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource RecordBrush}"
                           Visibility="{Binding PausedText, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <WrapPanel>
                <Button Content="取り消す(_C)" Tag="&#xE711;" Command="{Binding CancelCommand}" Style="{StaticResource ActionButton}"
                        ToolTip="順番待ちか実行中の処理を取り消します。終わった区間と録音は残ります" />
                <Button Content="続きからやり直す(_T)" Tag="&#xE72C;" Command="{Binding RetryCommand}" Style="{StaticResource ActionButton}"
                        ToolTip="失敗・取り消しした処理を、終わった区間はそのままに残りだけ実行します" />
                <Button Content="{Binding HoldLabel}" Tag="&#xE769;" Command="{Binding ToggleHoldCommand}" Style="{StaticResource ActionButton}"
                        ToolTip="順番待ちの文字起こしと記録の作成を始めないでおきます（実行中の処理は最後まで続けます）" />
                <Button Content="一覧を更新(_U)" Tag="&#xE72C;" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}" />
                <Button Content="診断情報を書き出す(_D)" Tag="&#xE9D9;" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource ActionButton}"
                        ToolTip="版・ハッシュ・設定・件数・エラーコードを logs フォルダーに書き出します。文字起こしや課題・タスクの本文は含みません" />
            </WrapPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="4,8,0,0" AutomationProperties.LiveSetting="Polite" />

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid services:TextScaling.ScaleColumns="True" ItemsSource="{Binding Jobs}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None"
                      BorderThickness="0" Background="Transparent" AutomationProperties.Name="最近の処理">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="受付" Binding="{Binding TimeText}" Width="100" />
                    <DataGridTextColumn Header="セッション" Binding="{Binding SessionText}" Width="2*" />
                    <DataGridTextColumn Header="種類" Binding="{Binding KindText}" Width="110" />
                    <DataGridTextColumn Header="モデル" Binding="{Binding ModelText}" Width="190" />
                    <DataGridTextColumn Header="状態" Binding="{Binding StateText}" Width="130" />
                    <DataGridTextColumn Header="内容" Binding="{Binding ErrorText}" Width="3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="4,6" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
    </Border>
    </ScrollViewer>
</UserControl>
