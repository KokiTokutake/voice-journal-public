<Window x:Class="VoiceJournal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VoiceJournal.App.ViewModels"
        xmlns:views="clr-namespace:VoiceJournal.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Voice Journal" Icon="/Assets/VoiceJournal.ico"
        Width="1180" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header: app name, navigation and the always-visible recording indicator (detail spec 18.1) -->
        <Grid DockPanel.Dock="Top" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/VoiceJournal-256.png" Width="28" Height="28" Margin="0,0,10,0" />
                <TextBlock Text="Voice Journal" FontSize="{DynamicResource VjFont18}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource RecPill}" VerticalAlignment="Center"
                    Visibility="{Binding IsRecordingActive, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding IndicatorText}" Foreground="White" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                           AutomationProperties.Name="録音インジケーター" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Margin="24,4,24,0" Text="{Binding StartupMessage}" Style="{StaticResource Note}" />

        <!-- Completion notice: a record made after the recording (often 30–60 minutes later, while minimized) -->
        <Border DockPanel.Dock="Top" Margin="24,8,24,0" Padding="14,8" CornerRadius="8" BorderThickness="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeIsProblem}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource CautionBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" Padding="8,4" Margin="6,0,0,0" VerticalAlignment="Center"
                        Command="{Binding DismissNoticeCommand}" ToolTip="この知らせを閉じる" AutomationProperties.Name="この知らせを閉じる" />
                <Button DockPanel.Dock="Right" Content="{Binding NoticeActionLabel}" Tag="&#xE8A7;" Command="{Binding OpenNoticeCommand}"
                        Style="{StaticResource AccentActionButton}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                           AutomationProperties.Name="処理の知らせ" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>

        <TabControl Margin="12,6,12,0" SelectedIndex="{Binding SelectedPageIndex}" BorderThickness="0" Background="Transparent" Padding="0"
                    ItemContainerStyle="{StaticResource NavTab}">
            <TabItem Header="録音(_R)">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <views:RecordingView DataContext="{Binding Recording}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="ライブラリ(_L)">
                <views:LibraryView DataContext="{Binding Library}" />
            </TabItem>
            <TabItem Header="文字起こし(_S)">
                <views:TranscriptView DataContext="{Binding Transcript}" />
            </TabItem>
            <TabItem Header="記録(_Y)">
                <views:RecordReviewView DataContext="{Binding Record}" />
            </TabItem>
            <TabItem Header="管理(_G)">
                <views:ManagementView DataContext="{Binding Management}" />
            </TabItem>
            <TabItem Header="処理状況(_J)">
                <views:ProcessingView DataContext="{Binding Processing}" />
            </TabItem>
            <TabItem Header="設定(_Z)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
